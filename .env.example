# Semua nilai di bawah adalah default. Aplikasi berjalan tanpa berkas .env;
# salin berkas ini menjadi .env hanya bila ingin mengubah nilainya.

# --- Backend ---
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
CORS_ORIGINS=http://localhost:3000   # asal frontend yang diizinkan, pisahkan dengan koma
MAX_UPLOAD_MB=5                # batas ukuran unggahan CV
REFERENCE_DATE=                # YYYY-MM-DD; kosong = tanggal hari ini (lihat docs/CV_PARSER.md)

# --- Screening ---
EMBEDDING_BACKEND=auto         # auto | e5 | tfidf  (auto = E5 bila terpasang, selain itu TF-IDF)
INSTALL_E5=false               # true = image Docker menyertakan multilingual-e5-small (+2 GB)
SHORTLIST_THRESHOLD=70         # skor >= nilai ini dan tanpa pelanggaran syarat wajib = Lolos
REJECT_THRESHOLD=45            # skor di bawah nilai ini = Tidak lolos

# --- Ringkasan HR (Gemini) ---
GEMINI_API_KEY=                # kosong = ringkasan memakai templat deterministik
GEMINI_MODEL=gemini-3.6-flash  # ganti bila model ini tidak tersedia untuk kunci Anda

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000   # alamat backend dilihat dari peramban
