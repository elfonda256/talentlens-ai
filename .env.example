# Semua nilai di bawah adalah default: aplikasi berjalan tanpa berkas .env.
# Salin berkas ini hanya bila ingin mengubah nilainya:
#   - tanpa Docker : cp .env.example backend/.env
#   - Docker Compose: cp .env.example .env
# Tulis komentar di barisnya sendiri, jangan di belakang nilai.

# --- Backend ---
# development | test | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Asal frontend yang diizinkan, pisahkan dengan koma
CORS_ORIGINS=http://localhost:3000
# Kunci bersama yang wajib dikirim di header X-API-Key ke semua endpoint selain /health.
# Kosong = tanpa kunci (hanya untuk lokal). Wajib diisi bila APP_ENV=production.
# Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Batas ukuran unggahan CV dan lowongan
MAX_UPLOAD_MB=5
# Tanggal acuan masa kerja "sampai sekarang", format YYYY-MM-DD. Kosong = hari ini.
REFERENCE_DATE=

# --- Screening ---
# auto | e5 | tfidf  (auto = E5 bila terpasang, selain itu TF-IDF)
EMBEDDING_BACKEND=auto
# Skor >= nilai ini dan tanpa pelanggaran syarat wajib = Lolos
SHORTLIST_THRESHOLD=70
# Skor di bawah nilai ini = Tidak lolos
REJECT_THRESHOLD=45

# --- Ringkasan HR (Gemini) ---
# Kunci dari Google AI Studio. Kosong = ringkasan memakai templat deterministik.
GEMINI_API_KEY=
# Ganti bila model ini tidak tersedia untuk kunci Anda
GEMINI_MODEL=gemini-3.6-flash

# --- Hanya Docker Compose ---
# true = image backend menyertakan multilingual-e5-small (+2 GB)
INSTALL_E5=false

# --- Frontend (dibaca di server Next.js, tidak pernah dikirim ke peramban) ---
# Tanpa Docker, letakkan keduanya di frontend/.env.local
# Alamat backend dilihat dari server frontend
BACKEND_URL=http://localhost:8000
# Sama dengan API_KEY backend
BACKEND_API_KEY=
