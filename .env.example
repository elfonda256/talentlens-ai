# Semua nilai di bawah adalah default. Aplikasi berjalan tanpa berkas .env;
# salin berkas ini menjadi .env hanya bila ingin mengubah nilainya.

# --- Backend ---
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
CORS_ORIGINS=http://localhost:3000   # asal frontend yang diizinkan, pisahkan dengan koma

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000   # alamat backend dilihat dari peramban
